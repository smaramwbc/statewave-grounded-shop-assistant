{
  "name": "statewave-grounded-shop-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "Statewave use case: Grounded Product Advisor & Support Assistant, with an Ops Assistant for content/QA gap tracking.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "seed": "tsx server/src/ingest/run.ts",
    "predev": "npm run build:widget",
    "dev": "tsx watch server/src/index.ts",
    "prestart": "npm run build:widget",
    "start": "tsx server/src/index.ts",
    "build": "tsc -b",
    "build:widget": "tsc -p packages/chat-widget",
    "test": "tsx --test packages/*/test/*.test.ts server/test/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
