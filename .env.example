# Copy this file to .env and fill in what you have.
# The whole demo runs WITHOUT a key too (offline grounded responder) —
# set OPENROUTER_API_KEY only when you want real LLM-generated answers,
# pointing it at an LLM gateway of your choice.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: route completions through a self-hosted LiteLLM proxy instead of
# the gateway above. LiteLLM isn't a model provider itself — it's a unified
# proxy in front of whichever provider(s) you configure it with (OpenAI,
# Anthropic, Bedrock, a local Ollama model, etc.) — so cost depends on what's
# behind it. When LITELLM_BASE_URL is set it takes priority over
# OPENROUTER_API_KEY.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini

# Port the demo server (storefront + ops console + APIs) listens on.
PORT=4000

# Protects /api/ops/* (internal console + gap resolution). If unset, the ops
# routes are left OPEN and the server logs a loud warning on boot — fine for
# a local demo, not for anything deployed beyond localhost.
OPS_API_KEY=

# Set to 1 only if this process runs behind a reverse proxy/load balancer.
# Enables reading the real client IP from X-Forwarded-For for rate limiting.
# Leave unset for local/direct runs — trusting it without a real proxy in
# front lets clients spoof their own rate-limit identity.
TRUST_PROXY=
